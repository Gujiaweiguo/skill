{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scan-coverage.schema.json",
  "title": "Scanner coverage manifest",
  "type": "object",
  "required": ["status", "scope"],
  "properties": {
    "status": {"enum": ["complete", "partial", "not-scanned", "inaccessible"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "scanners": {
      "type": "object",
      "properties": {
        "specs": {"$ref": "#/$defs/scanner"},
        "matrix": {"$ref": "#/$defs/scanner"},
        "direct_code": {"$ref": "#/$defs/scanner"},
        "direct_tests": {"$ref": "#/$defs/scanner"},
        "docs": {"$ref": "#/$defs/scanner"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "scanner": {
      "type": "object",
      "required": ["status", "scope"],
      "properties": {
        "status": {"enum": ["complete", "partial", "not-scanned", "inaccessible"]},
        "scope": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "artifact_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
