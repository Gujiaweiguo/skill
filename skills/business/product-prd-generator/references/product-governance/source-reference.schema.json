{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-reference.schema.json",
  "title": "Product governance source reference",
  "type": "object",
  "required": ["source_id", "source_type", "source_ref", "evidence_state"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["material_source", "customer_requirement", "competitor_observation", "code_fact", "spec_fact", "test_fact", "ontology_assertion", "product_decision"]
    },
    "source_ref": {"type": "string", "minLength": 1},
    "material_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_state": {
      "enum": ["observed", "inferred", "not_found", "not_scanned", "inaccessible", "conflicting", "not_applicable"]
    },
    "confidence": {"enum": ["high", "medium", "low", "unassessed"]},
    "decision": {
      "type": "object",
      "required": ["decision_id", "owner", "status", "rationale"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "owner": {"const": "OPC"},
        "status": {"enum": ["proposed", "accepted", "rejected", "deferred", "superseded"]},
        "rationale": {"type": "string", "minLength": 1},
        "supporting_source_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_type": {"const": "product_decision"}}, "required": ["source_type"]},
      "then": {"required": ["decision"]}
    },
    {
      "if": {"properties": {"source_type": {"enum": ["customer_requirement", "competitor_observation", "code_fact", "spec_fact", "test_fact", "ontology_assertion"]}}, "required": ["source_type"]},
      "then": {"not": {"required": ["decision"]}}
    },
    {
      "if": {"properties": {"source_type": {"enum": ["code_fact", "spec_fact", "test_fact"]}}, "required": ["source_type"]},
      "then": {"required": ["revision"]}
    }
  ],
  "additionalProperties": false
}
